{
  "_ghi_chu": "Mẫu mục 6.2 — CHÉP các phần tử trong 'headers' dưới đây vào mảng hosting.headers của firebase.json (thêm vào, KHÔNG thay cả mảng, KHÔNG đổi header của XOFA / The Cafe 33). File này chỉ để chép, không dùng trực tiếp.",
  "headers": [
    { "source": "/unit_engine.v*.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/che_do_thu.v*.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/@(posgieo|quanlygieo).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/@(posgieo_thu|quanlygieo_thu).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
